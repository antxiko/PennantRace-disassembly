# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0xA171 ymmm orden YMMM (0xE0) del VDP: mueve en vertical una franja
L 0xA1CC tres_cifras un numero de 3 cifras BCD con los ceros de delante en blanco
L 0xA1E7 cifra_15 una cifra (1-10, o 0 en blanco) y 8 a la derecha
L 0xA1F8 tres_cifras_con_ceros tres cifras BCD sin quitar ceros
L 0xA22D texto_15 un texto con [x y] y caracteres de la fuente hasta 0xFF
L 0xA241 diez_letras 10 letras en ASCII (el '$' acaba)
L 0xA259 caracter_15 un caracter de la fuente de la pagina 1 a la 1
L 0xA651 diez_letras_2 10 letras ASCII en la fuente
L 0xA9C9 columnas_bcd B jugadores: tres bytes de cifras (- 1) a dos BCD en DE, saltando C bytes
L 0xA9E5 columna_bcd B jugadores: dos bytes de cifras (- 1) a un BCD en DE, saltando C bytes
L 0xA9FC cuatro_lanzadores un valor - 1 de cada uno de los 4 lanzadores (19 bytes) a DE, y su suma
L 0xAA13 suma_bcd HL = la suma BCD de B bytes de DE
L 0xAA23 resta_bcd guarda la suma y DE = BC - la suma (BCD)
L 0xAA31 resta_de_25 guarda la suma y A = 0x25 - la suma (BCD)
L 0xAC7A azar_16 un numero al azar de 0 a 15
L 0xACD2 partido_jugado uno mas en la tabla de partidos para H contra L y L contra H
L 0xAD75 victorias_de HL = las victorias de la ficha del equipo A (+11)
L 0xAD7D ficha_del_equipo HL = la ficha de 15 bytes del equipo A en 0xD680
L 0xAD8A azar al azar: 0xD6E0 += R x 3
L 0xAD98 bcd_mas_uno uno mas al BCD de 4 cifras de HL
L 0xADA4 a_bcd A a BCD: las centenas en 0xE379, el resto en 0xE37A
L 0xADD0 bcd_a_binario A = el BCD de 3 cifras de HL en binario
L 0xADEB diez_ascii 10 letras ASCII
L 0xAE9E columna_de_caracteres B caracteres A en columna, de 12 en 12
L 0xAF26 nombre_del_equipo el nombre del equipo A (10 letras)
L 0xAF2C tabla_de_pennant la tabla de PENNANT: cada equipo con partidos, victorias, derrotas, porcentaje y diferencia
L 0xB061 tres_cifras_en_fila tres cifras en la fila 0xE372, x = D
L 0xB13C cuadro_44 un rectangulo de 16 x 16 de color 0x44 en DE
L 0xB140 cuadro_55 un rectangulo de 16 x 16 de color 0x55 en DE
L 0xB14E letrero el letrero A de la tabla 0xB20D (2 x 2 caracteres) en DE
L 0xB22D caracter_lmmm un caracter de la fuente con LMMM (sin el color 0)
L 0xB5DD menos_hl_15 HL = -HL
L 0xB5E5 menos_de_15 DE = -DE
L 0xB611 pelota_al_lanzador la pelota en manos del lanzador
L 0xB623 pelota_tras_robo tras un robo, la pelota al lanzador o al receptor
L 0xBA0A cifra_en_casilla la cifra B en el sitio D de la casilla HL: A = el byte nuevo
L 0xBA2D suma_bcd_16 la suma BCD de B palabras de DE, guardada en HL
L 0xBA44 bc_menos_hl HL = BC - HL (BCD); carry si pasa
