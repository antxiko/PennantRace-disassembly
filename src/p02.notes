

# --- A MANO: comentarios escritos leyendo el codigo ---
C 0x8000 dos bytes de datos
C 0x8002 0xED0A = 2: nada
C 0x8009 el mando con el bit 4 (boton 1): lanza
C 0x800F si la pelota esta en el aire o la jugada ha acabado...
C 0x8012 con bote, nada
C 0x8018 sin cogerla, nada
C 0x801A ...nada que decidir y al paso 3
C 0x801E al paso 3 (p01:7F56)
C 0x8021 el lanzador (1) espera 0xED00 cuadros y lanza
C 0x8024 si no la tiene el lanzador, p02:800F
C 0x802A la espera
C 0x802F con el bit 4: lanza
C 0x8035 al paso siguiente; el 7 y el 8 (los exteriores) eligen base
C 0x803B solo el 7 y el 8
C 0x8046 a la 1.a
C 0x804C el 7: de la base 8 o de la 2 en el juego 0, a la 4
C 0x804F de la base 8: a la 1.a
C 0x8056 de la 2: en la zona 0, a la 4
C 0x8063 el 8: de la 4, a la 1; de la 2 en el juego 2, a la 8
C 0x8066 de la 4: a la 1.a
C 0x806D de la 2: en la zona 2, a la 8
C 0x807B la distancia del corredor de 0xED0B a la pelota
C 0x8081 la del defensor A (desplazamiento de 16 en 16)
C 0x8084 IX = 0xE271 + A
C 0x808A |x de la pelota - x|...
C 0x808D |x de la pelota - su x|
C 0x8096 a DE
C 0x8097 ...|y de la pelota - y|...
C 0x809A |y de la pelota - su y|
C 0x80A3 la mayor de las dos
C 0x80AC DE era mayor
C 0x80AE HL era mayor
C 0x80B1 HL = |HL - BC|
C 0x80B2 HL - BC...
C 0x80B6 ...en valor absoluto
C 0x80BA el defensor que va a por la pelota: 0xED40 (si no es 0xFF)...
C 0x80BF 0xFF: p02:80D6
C 0x80C1 el que va
C 0x80C4 0x70: nada mas
C 0x80C7 el puesto (0xECE7, 0xECE9)
C 0x80CE fuera del alcance?
C 0x80D4 dentro: nada mas
C 0x80D6 si no, 0xED41 (p02:832B), o 0xED42 con 0xECFF
C 0x80DC el segundo y su alcance
C 0x80E9 sin 0xECFF, nada mas
C 0x80EB el exterior
C 0x80F2 hacia donde va la pelota: segun las velocidades (0xE215, 0xE21A)...
C 0x80F9 |vy|
C 0x80FE vx hacia la derecha...
C 0x8102 ...2 x vx contra |vy|: menor, 0x10
C 0x8108 mayor: nadie
C 0x810A vx hacia la izquierda...
C 0x810D ...2 x |vx| contra |vy|: menor, 0x10; mayor, 0x20
C 0x8115 lo mismo segun donde esta: el byte alto de la x...
C 0x811C x alta 0: p02:8136
C 0x8120 x alta 1: p02:8146
C 0x8123 ...y + 2x > 0x3F8: 0x10...
C 0x8129 por debajo: 0x10
C 0x812B ...0 nadie...
C 0x812C nadie
C 0x8130 0x10: el defensor de la ficha 0xE281 (desplazamiento 16)
C 0x8136 ...2x + y + 0xE8 > 0xFFFF: 0x10, si no 0x20
C 0x813E menor: 0x10
C 0x8140 si no, 0x20
C 0x8146 x baja por debajo de 0x38: p02:8136
C 0x814D segun 0xED9D (el tipo de golpe): 7 en adelante, p02:8186...
C 0x8150 7 o mas: p02:8186
C 0x8154 5 o 6: p02:8199
C 0x8158 ...si no, los corredores (p02:81BC)...
C 0x815B las bases ocupadas en C
C 0x815C 1 o 4: p02:8169
C 0x8164 si no, 0x80 o 0xFF segun el tipo (p02:81AA)
C 0x8169 ...0xED40 = 0xFF o 0x80...
C 0x816E si el tipo es la base, 0xFF; si no, 0x80
C 0x8177 ...y 0xED41 de la tabla 0x81B8
C 0x817B la entrada tipo - 1 de 0x81B8
C 0x8186 7 en adelante: 0xED40 = 0x70, 0xED41 = 0x60 o 0x40 segun el signo de 0xE21B
C 0x818B hacia la izquierda: 0x40; a la derecha: 0x60
C 0x8199 5: 0xED41 = 0x60, 6: 0x40; 0xED40 = 0x80
C 0x81AA 2 o 3: 0x80, si no 0xFF
C 0x81B8 el segundo defensor de cada tipo de golpe (4 bytes)
C 0x81BC C = las bases ocupadas: los 4 corredores de 0xECA3 (bit 0 primera, 1 segunda, 2 tercera)
C 0x81C5 cada corredor de la copia (0xECA3)
C 0x81CC su base
C 0x81CF la 2: bit 0
C 0x81D5 la 3: bit 1
C 0x81DB la 4: bit 2
C 0x81E1 0xED40 = 0x70, o 0x80 con 0xE2EE
C 0x81E6 con base de destino del receptor (0xE2EE)...
C 0x81EB ...0x80
C 0x81F1 el defensor a donde va la pelota (0xE213, 0xE218)
C 0x81F8 x alta 0: p02:8212
C 0x81FC x alta 1: p02:821E
C 0x81FF x alta 2: x + 0x18 contra y
C 0x820A dentro
C 0x820C fuera: 1
C 0x8212 y + x - 0x270
C 0x8219 dentro: 0xED43 = 0
C 0x821E x baja de 0x38 o mas: como la alta
C 0x8225 la base a la que lanzar, en 0xED6E
C 0x822C la 1: 8
C 0x8230 la 2: 1
C 0x8234 la 3: 4
C 0x8238 si no: 2
C 0x823B el corredor mas adelantado que no vuelve (p02:824A)...
C 0x823E con alguno, su base
C 0x8242 ...si no hay, 0xEDD5 = 1 y a la base de p02:8278
C 0x824A C = la base mas alta (menos uno) de los corredores que corren...
C 0x824E IY: la copia de 0xEC98
C 0x8252 B = 4, C = 0
C 0x8258 ...con base (IX+11), sin el bit 6 de IX+13...
C 0x825D sin base, no
C 0x825F parado (bit 6 de +13), no
C 0x8265 ...y con la copia de 0xEC98 en marcha
C 0x826A sin base en la copia, no
C 0x826C la base - 1, si es mayor
C 0x8271 el siguiente
C 0x8278 la base para cortar: las de los corredores (p02:82A7)...
C 0x827B ...con menos de 2 outs y uno yendo a casa (0xEDC8 = 4)...
C 0x827E con 2 outs, no
C 0x8285 si el mas adelantado que no vuelve va a casa (4)...
C 0x828D ...y no tiene el bit 7: a casa
C 0x8293 ...si no, la de 0xEDC9 o la de 0xEDC8
C 0x8296 la de los que corren
C 0x829C o la de los que no vuelven
C 0x82A0 su base
C 0x82A7 los corredores: 0xED0B, 0xEDCC y 0xEDC7-0xEDC9 a cero, 0xEDCA = 0xFF...
C 0x82AA 0xED0B y 0xEDCC a 0
C 0x82B4 0xEDC7-0xEDC9 a 0 y 0xEDCA a 0xFF
C 0x82BC ...y por cada uno con base...
C 0x82C5 la base del corredor
C 0x82CA sin base, no
C 0x82D5 ...0xEDC7 la mas alta (y 0xED0B quien)...
C 0x82D8 la mas alta (p02:8300)
C 0x82DC ...0xEDC8 la mas alta de los que no vuelven (y 0xEDCC quien)...
C 0x82E4 ...0xEDC9 la mas alta de los que corren (bit 5 de IX+13)...
C 0x82ED ...0xEDCA la mas baja
C 0x82F2 si es mayor, la nueva
C 0x82F7 si es mayor...
C 0x82FA ...la nueva y su ficha
C 0x8300 si es mayor...
C 0x8303 ...la nueva y quien (0xED0B)
C 0x8309 carry si el corredor de 0xEDC8 + 1 llegara antes (p15:B06E)
C 0x830C la base siguiente
C 0x830F carry si el de 0xEDC8 llegara antes
C 0x8312 con el bit 6: ya llego
C 0x8318 la base de 0xEDC8 (p02:822C), o 0
C 0x831B la base de 0xEDC8
C 0x831F sin corredor, 0
C 0x8324 0xECFF = 1 si la pelota (0xE213, 0xE218) esta en el campo exterior
C 0x832B x alta 0: p02:8347
C 0x832F x alta 1: p02:8357
C 0x8332 x / 2 + 0x3C contra y
C 0x833F menor: cerca
C 0x8341 lejos: 1
C 0x8347 y + x / 2 - 0x174
C 0x8352 cerca: 0
C 0x8357 x baja de 0x38 o mas: como la alta
C 0x835E carry si la pelota esta en el cuadro (y + 12 < x / 2, o y + x / 2 < 0x12C)
C 0x8365 x alta 0: p02:837A
C 0x8369 x alta 1: p02:8385
C 0x836C y + 0x0C - x / 2
C 0x8377 el signo al carry
C 0x837A y + x / 2 - 0x12C...
C 0x8383 ...al reves
C 0x8385 x baja de 0x38 o mas: p02:836C
C 0x838C la cuenta de lanzamientos: segun quien lleve al lanzador (p02:83B7)...
C 0x838D 0xED73 a 0
